generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  DISABLED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

enum MembershipRole {
  OWNER
  PROPERTY_MANAGER
}

enum BedOperationalStatus {
  IN_SERVICE
  OUT_OF_SERVICE
}

enum ResidentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  INTERESTED
  CONVERTED
  LOST
  ARCHIVED
}

enum EnquirySource {
  WEBSITE
  PHONE_CALL
  WALK_IN
  REFERRAL
  SOCIAL_MEDIA
  OTHER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
}

enum AdmissionStatus {
  PENDING
  ADMITTED
  CANCELLED
}

model Organization {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships Membership[]
  properties  Property[]
  auditEvents AuditEvent[]
  residents   Resident[]
  enquiries   Enquiry[]
  bookings    Booking[]
  admissions  Admission[]

  @@map("organizations")
}

model User {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loginIdentifier  String            @unique @map("login_identifier")
  passwordHash     String            @map("password_hash")
  displayName      String            @map("display_name")
  status           UserStatus        @default(ACTIVE)
  lastLoginAt      DateTime?         @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships      Membership[]
  sessions         Session[]
  auditEvents      AuditEvent[]
  enquiryFollowUps EnquiryFollowUp[]

  @@map("users")
}

model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions       Session[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Session {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash            String      @unique @map("token_hash")
  userId               String      @map("user_id") @db.Uuid
  activeOrganizationId String?     @map("active_organization_id") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt           DateTime    @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt        DateTime    @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt    DateTime    @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt            DateTime?   @map("revoked_at") @db.Timestamptz(6)
  revokedReason        String?     @map("revoked_reason")
  user                 User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership           Membership? @relation(fields: [activeOrganizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([idleExpiresAt])
  @@map("sessions")
}

model AuditEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String
  targetType     String        @map("target_type")
  targetId       String?       @map("target_id")
  requestId      String        @map("request_id")
  occurredAt     DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  reasonCode     String?       @map("reason_code")
  metadata       Json          @db.JsonB
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, occurredAt])
  @@map("audit_events")
}

model Property {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String
  name           String
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  floors         Floor[]
  enquiries      Enquiry[]
  admissions     Admission[]

  @@unique([id, organizationId])
  @@map("properties")
}

model Floor {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  label          String
  ordinal        Int
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  property       Property  @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  rooms          Room[]

  @@unique([id, propertyId, organizationId])
  @@index([propertyId, organizationId])
  @@map("floors")
}

model Room {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  propertyId     String      @map("property_id") @db.Uuid
  floorId        String      @map("floor_id") @db.Uuid
  label          String
  archivedAt     DateTime?   @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  floor          Floor       @relation(fields: [floorId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  beds           Bed[]
  admissions     Admission[]

  @@unique([id, propertyId, organizationId])
  @@index([floorId, propertyId, organizationId])
  @@map("rooms")
}

model Bed {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  propertyId         String               @map("property_id") @db.Uuid
  roomId             String               @map("room_id") @db.Uuid
  label              String
  operationalStatus  BedOperationalStatus @default(IN_SERVICE) @map("operational_status")
  outOfServiceReason String?              @map("out_of_service_reason")
  archivedAt         DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  price              Decimal              @default(0) @map("price") @db.Decimal(10, 2)
  room               Room                 @relation(fields: [roomId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  bookings           Booking[]
  admissions         Admission[]

  @@index([roomId, propertyId, organizationId])
  @@map("beds")
}

model Resident {
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String                     @map("organization_id") @db.Uuid
  firstName                  String                     @map("first_name")
  lastName                   String                     @map("last_name")
  dateOfBirth                DateTime?                  @map("date_of_birth") @db.Timestamptz(6)
  gender                     String?
  phone                      String?
  email                      String?
  address                    String?
  emergencyContactName       String?                    @map("emergency_contact_name")
  emergencyContactPhone      String?                    @map("emergency_contact_phone")
  emergencyContactRelation   String?                    @map("emergency_contact_relation")
  documentMetadata           Json?                      @map("document_metadata") @db.JsonB
  documentUrl                String?                    @map("document_url")
  documentVerificationStatus DocumentVerificationStatus @default(PENDING) @map("document_verification_status")
  status                     ResidentStatus             @default(ACTIVE)
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization               Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  enquiry                    Enquiry?
  bookings                   Booking[]
  admissions                 Admission[]

  @@map("residents")
}

model Booking {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  residentId     String        @map("resident_id") @db.Uuid
  bedId          String        @map("bed_id") @db.Uuid
  startDate      DateTime      @map("start_date") @db.Timestamptz(6)
  endDate        DateTime      @map("end_date") @db.Timestamptz(6)
  status         BookingStatus @default(CONFIRMED)
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  monthlyPrice   Decimal       @map("monthly_price") @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resident     Resident     @relation(fields: [residentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bed          Bed          @relation(fields: [bedId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  admission    Admission?

  @@index([organizationId, status])
  @@index([bedId, startDate, endDate])
  @@map("bookings")
}

model Admission {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  bookingId      String          @unique @map("booking_id") @db.Uuid
  residentId     String          @map("resident_id") @db.Uuid
  bedId          String          @map("bed_id") @db.Uuid
  propertyId     String?         @map("property_id") @db.Uuid
  roomId         String?         @map("room_id") @db.Uuid
  admissionDate  DateTime        @map("admission_date") @db.Timestamptz(6)
  status         AdmissionStatus @default(PENDING)
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resident     Resident     @relation(fields: [residentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bed          Bed          @relation(fields: [bedId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([organizationId, status])
  @@map("admissions")
}

model Enquiry {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String            @map("organization_id") @db.Uuid
  propertyId             String?           @map("property_id") @db.Uuid
  firstName              String            @map("first_name")
  lastName               String            @map("last_name")
  phone                  String            @map("phone")
  email                  String?
  preferredRoomType      String?           @map("preferred_room_type")
  expectedMoveInDate     DateTime?         @map("expected_move_in_date") @db.Timestamptz(6)
  expectedDurationOfStay Int?              @map("expected_duration_of_stay")
  numberOfOccupants      Int?              @map("number_of_occupants")
  source                 EnquirySource     @default(OTHER) @map("source")
  notes                  String?
  status                 EnquiryStatus     @default(NEW) @map("status")
  assignedUserId         String?           @map("assigned_user_id") @db.Uuid
  residentId             String?           @unique @map("resident_id") @db.Uuid
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  property               Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  resident               Resident?         @relation(fields: [residentId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  followUps              EnquiryFollowUp[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("enquiries")
}

model EnquiryFollowUp {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiryId  String   @map("enquiry_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  notes      String
  followUpAt DateTime @map("follow_up_at") @db.Timestamptz(6)
  outcome    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([enquiryId, followUpAt])
  @@map("enquiry_follow_ups")
}
