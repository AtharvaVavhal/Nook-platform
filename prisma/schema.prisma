generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated"
}
datasource db {
  provider = "postgresql"
}
enum OrganizationStatus {
  ACTIVE
  DISABLED
}
enum UserStatus {
  ACTIVE
  DISABLED
}
enum MembershipStatus {
  ACTIVE
  REVOKED
}
enum MembershipRole {
  OWNER
  PROPERTY_MANAGER
}
enum BedOperationalStatus {
  IN_SERVICE
  OUT_OF_SERVICE
}
enum ResidentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}
enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}
enum EnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  INTERESTED
  CONVERTED
  LOST
  ARCHIVED
}
enum EnquirySource {
  WEBSITE
  PHONE_CALL
  WALK_IN
  REFERRAL
  SOCIAL_MEDIA
  OTHER
}
enum BookingStatus {
  CONFIRMED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
}
enum CheckInStatus {
  ACTIVE
  CHECKED_OUT
}
enum AdmissionStatus {
  PENDING
  ADMITTED
  CANCELLED
}
enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}
enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
}
model Organization {
  assignmentReplacements StayAssignmentReplacement[]
  transferFinanceReviews TransferFinanceReview[]
  correctionProposals      CorrectionProposal[]
  correctionReceipts       CorrectionCommandReceipt[]
  correctionFinanceLinks   CorrectionFinanceLink[]
  stayAssignments          StayAssignment[]
  transfers                Transfer[]
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  status                   OrganizationStatus         @default(ACTIVE)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships              Membership[]
  properties               Property[]
  auditEvents              AuditEvent[]
  residents                Resident[]
  enquiries                Enquiry[]
  bookings                 Booking[]
  admissions               Admission[]
  checkIns                 CheckIn[]
  checkOuts                CheckOut[]
  invoices                 Invoice[]
  payments                 Payment[]
  paymentIdempotencyKeys   PaymentIdempotencyKey[]
  paymentReversals         PaymentReversal[]
  invoiceAdjustments       InvoiceAdjustment[]
  invoiceVoids             InvoiceVoid[]
  @@map("organizations")
}
model User {
  assignmentReplacements StayAssignmentReplacement[]
  transferReviewRequests TransferFinanceReview[]
  transferReviewResolutions TransferFinanceResolution[]
  correctionsRequested    CorrectionProposal[]       @relation("CorrectionRequester")
  correctionsDecided      CorrectionProposal[]       @relation("CorrectionDecider")
  correctionReceipts      CorrectionCommandReceipt[]
  correctionLinksResolved CorrectionFinanceLink[]
  transfers               Transfer[]
  id                      String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loginIdentifier         String                     @unique @map("login_identifier")
  passwordHash            String                     @map("password_hash")
  displayName             String                     @map("display_name")
  status                  UserStatus                 @default(ACTIVE)
  /// True for a temporary password (provisioning or operator reset): the user must set their own before using the app.
  passwordChangeRequired  Boolean                    @default(false) @map("password_change_required")
  lastLoginAt             DateTime?                  @map("last_login_at") @db.Timestamptz(6)
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships             Membership[]
  sessions                Session[]
  auditEvents             AuditEvent[]
  enquiryFollowUps        EnquiryFollowUp[]
  paymentReversals        PaymentReversal[]
  invoiceAdjustments      InvoiceAdjustment[]
  invoiceVoids            InvoiceVoid[]
  @@map("users")
}
model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions       Session[]
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}
model Session {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash            String      @unique @map("token_hash")
  userId               String      @map("user_id") @db.Uuid
  activeOrganizationId String?     @map("active_organization_id") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt           DateTime    @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt        DateTime    @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt    DateTime    @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt            DateTime?   @map("revoked_at") @db.Timestamptz(6)
  revokedReason        String?     @map("revoked_reason")
  user                 User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership           Membership? @relation(fields: [activeOrganizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  @@index([userId])
  @@index([idleExpiresAt])
  @@map("sessions")
}
model AuditEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String
  targetType     String        @map("target_type")
  targetId       String?       @map("target_id")
  requestId      String        @map("request_id")
  occurredAt     DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  reasonCode     String?       @map("reason_code")
  metadata       Json          @db.JsonB
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([organizationId, occurredAt])
  @@map("audit_events")
}
model Property {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String
  name           String
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  floors         Floor[]
  enquiries      Enquiry[]
  admissions     Admission[]
  @@unique([id, organizationId])
  @@map("properties")
}
model Floor {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  label          String
  ordinal        Int
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  property       Property  @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  rooms          Room[]
  @@unique([id, propertyId, organizationId])
  @@index([propertyId, organizationId])
  @@map("floors")
}
model Room {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  propertyId     String      @map("property_id") @db.Uuid
  floorId        String      @map("floor_id") @db.Uuid
  label          String
  archivedAt     DateTime?   @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  floor          Floor       @relation(fields: [floorId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  beds           Bed[]
  admissions     Admission[]
  @@unique([id, propertyId, organizationId])
  @@index([floorId, propertyId, organizationId])
  @@map("rooms")
}
model Bed {
  effectiveAssignments EffectiveStayAssignment[]
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String               @map("organization_id") @db.Uuid
  propertyId            String               @map("property_id") @db.Uuid
  roomId                String               @map("room_id") @db.Uuid
  label                 String
  operationalStatus     BedOperationalStatus @default(IN_SERVICE) @map("operational_status")
  outOfServiceReason    String?              @map("out_of_service_reason")
  archivedAt            DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Price field currently UNUSED for billing.
  /// Rent is determined by Booking.monthlyPrice (snapshot at booking creation).
  /// This field may be used in future for reference/list pricing only.
  price                 Decimal              @default(0) @map("price") @db.Decimal(10, 2)
  room                  Room                 @relation(fields: [roomId, propertyId, organizationId], references: [id, propertyId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  bookings              Booking[]
  admissions            Admission[]
  checkIns              CheckIn[]
  checkOuts             CheckOut[]
  stayAssignments       StayAssignment[]
  sourceTransfers       Transfer[]           @relation("TransferSourceBed")
  destTransfers         Transfer[]           @relation("TransferDestBed")
  @@unique([id, organizationId])
  @@index([roomId, propertyId, organizationId])
  @@map("beds")
}
model Resident {
  assignmentReplacements StayAssignmentReplacement[]
  transferFinanceReviews TransferFinanceReview[]
  correctionFinanceLinks     CorrectionFinanceLink[]
  correctionProposals        CorrectionProposal[]       @relation("CorrectionResidentTarget")
  stayAssignments            StayAssignment[]
  transfers                  Transfer[]
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String                     @map("organization_id") @db.Uuid
  firstName                  String                     @map("first_name")
  lastName                   String                     @map("last_name")
  dateOfBirth                DateTime?                  @map("date_of_birth") @db.Timestamptz(6)
  gender                     String?
  phone                      String?
  email                      String?
  address                    String?
  emergencyContactName       String?                    @map("emergency_contact_name")
  emergencyContactPhone      String?                    @map("emergency_contact_phone")
  emergencyContactRelation   String?                    @map("emergency_contact_relation")
  documentMetadata           Json?                      @map("document_metadata") @db.JsonB
  documentUrl                String?                    @map("document_url")
  documentVerificationStatus DocumentVerificationStatus @default(PENDING) @map("document_verification_status")
  status                     ResidentStatus             @default(ACTIVE)
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization               Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  enquiry                    Enquiry?
  bookings                   Booking[]
  admissions                 Admission[]
  checkIns                   CheckIn[]
  checkOuts                  CheckOut[]
  invoices                   Invoice[]
  payments                   Payment[]
  @@unique([id, organizationId])
  @@map("residents")
}
model Booking {
  assignmentReplacements StayAssignmentReplacement[]
  effectiveAssignments EffectiveStayAssignment[]
  transferFinanceReviews TransferFinanceReview[]
  correctionFinanceLinks CorrectionFinanceLink[]
  correctionProposals    CorrectionProposal[]    @relation("CorrectionBookingTarget")
  stayAssignments        StayAssignment[]
  transfers              Transfer[]
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  residentId             String                  @map("resident_id") @db.Uuid
  bedId                  String                  @map("bed_id") @db.Uuid
  startDate              DateTime                @map("start_date") @db.Timestamptz(6)
  endDate                DateTime                @map("end_date") @db.Timestamptz(6)
  status                 BookingStatus           @default(CONFIRMED)
  paymentStatus          PaymentStatus           @default(PENDING) @map("payment_status")
  monthlyPrice           Decimal                 @map("monthly_price") @db.Decimal(10, 2)
  notes                  String?
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resident     Resident     @relation(fields: [residentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  bed          Bed          @relation(fields: [bedId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  admission    Admission?
  checkIns     CheckIn[]
  checkOuts    CheckOut[]
  invoices     Invoice[]
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([bedId, startDate, endDate])
  @@map("bookings")
}
model Admission {
  correctionProposals CorrectionProposal[] @relation("CorrectionAdmissionTarget")
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  bookingId           String               @unique @map("booking_id") @db.Uuid
  residentId          String               @map("resident_id") @db.Uuid
  bedId               String               @map("bed_id") @db.Uuid
  propertyId          String?              @map("property_id") @db.Uuid
  roomId              String?              @map("room_id") @db.Uuid
  admissionDate       DateTime             @map("admission_date") @db.Timestamptz(6)
  status              AdmissionStatus      @default(PENDING)
  notes               String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  booking      Booking      @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  resident     Resident     @relation(fields: [residentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  bed          Bed          @relation(fields: [bedId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  checkIn      CheckIn?
  @@unique([id, organizationId])
  @@unique([bookingId, organizationId])
  @@index([organizationId, status])
  @@map("admissions")
}
model Enquiry {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String            @map("organization_id") @db.Uuid
  propertyId             String?           @map("property_id") @db.Uuid
  firstName              String            @map("first_name")
  lastName               String            @map("last_name")
  phone                  String            @map("phone")
  email                  String?
  preferredRoomType      String?           @map("preferred_room_type")
  expectedMoveInDate     DateTime?         @map("expected_move_in_date") @db.Timestamptz(6)
  expectedDurationOfStay Int?              @map("expected_duration_of_stay")
  numberOfOccupants      Int?              @map("number_of_occupants")
  source                 EnquirySource     @default(OTHER) @map("source")
  notes                  String?
  status                 EnquiryStatus     @default(NEW) @map("status")
  assignedUserId         String?           @map("assigned_user_id") @db.Uuid
  residentId             String?           @unique @map("resident_id") @db.Uuid
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  property               Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  resident               Resident?         @relation(fields: [residentId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  followUps              EnquiryFollowUp[]
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("enquiries")
}
model EnquiryFollowUp {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiryId  String   @map("enquiry_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  notes      String
  followUpAt DateTime @map("follow_up_at") @db.Timestamptz(6)
  outcome    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([enquiryId, followUpAt])
  @@map("enquiry_follow_ups")
}
model CheckIn {
  correctionProposals CorrectionProposal[] @relation("CorrectionCheckInTarget")
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  admissionId         String               @unique @map("admission_id") @db.Uuid
  residentId          String               @map("resident_id") @db.Uuid
  bedId               String               @map("bed_id") @db.Uuid
  bookingId           String               @map("booking_id") @db.Uuid
  checkInAt           DateTime             @map("check_in_at") @db.Timestamptz(6)
  status              CheckInStatus        @default(ACTIVE) @map("status")
  notes               String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  admission    Admission    @relation(fields: [admissionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  resident     Resident     @relation(fields: [residentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  bed          Bed          @relation(fields: [bedId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  booking      Booking      @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  checkOut     CheckOut?
  @@unique([id, organizationId])
  @@unique([admissionId, organizationId])
  @@index([organizationId, status])
  @@map("check_ins")
}
model CheckOut {
  correctionProposals CorrectionProposal[] @relation("CorrectionCheckOutTarget")
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  checkInId           String               @unique @map("check_in_id") @db.Uuid
  residentId          String               @map("resident_id") @db.Uuid
  bedId               String               @map("bed_id") @db.Uuid
  bookingId           String               @map("booking_id") @db.Uuid
  checkOutAt          DateTime             @map("check_out_at") @db.Timestamptz(6)
  reason              String?
  notes               String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checkIn      CheckIn      @relation(fields: [checkInId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  resident     Resident     @relation(fields: [residentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  bed          Bed          @relation(fields: [bedId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  booking      Booking      @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  @@unique([checkInId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("check_outs")
}
model Invoice {
  correctionFinanceLinks CorrectionFinanceLink[]
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  residentId             String                  @map("resident_id") @db.Uuid
  bookingId              String?                 @map("booking_id") @db.Uuid
  number                 String
  periodStart            DateTime                @map("period_start") @db.Date
  periodEnd              DateTime                @map("period_end") @db.Date
  amount                 Decimal                 @db.Decimal(12, 2)
  /// Amount settled: cash received net of reversals, plus applied credits (-adjustmentTotal).
  paidAmount             Decimal                 @default(0) @map("paid_amount") @db.Decimal(12, 2)
  /// Cached sum of invoice_adjustments (credits are stored negative; positive is not supported).
  adjustmentTotal        Decimal                 @default(0) @map("adjustment_total") @db.Decimal(12, 2)
  status                 InvoiceStatus           @default(DRAFT)
  dueDate                DateTime                @map("due_date") @db.Date
  issuedAt               DateTime?               @map("issued_at") @db.Timestamptz(6)
  notes                  String?
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resident     Resident            @relation(fields: [residentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  booking      Booking?            @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  payments     Payment[]
  adjustments  InvoiceAdjustment[]
  /// At most one (unique invoice_id); a list only because the unique key is narrower than the composite relation.
  voids        InvoiceVoid[]
  @@unique([organizationId, number])
  @@unique([id, organizationId, residentId])
  /// Partial unique indexes over non-CANCELLED invoices (one active invoice per booking per month, and per resident for
  /// legacy invoices with no booking) exist only in SQL: migration 20261103130000_invoice_active_uniqueness.
  @@index([organizationId, residentId, periodStart])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, periodStart])
  @@index([residentId, organizationId])
  @@map("invoices")
}
model Payment {
  correctionFinanceLinks CorrectionFinanceLink[]
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  invoiceId              String                  @map("invoice_id") @db.Uuid
  residentId             String                  @map("resident_id") @db.Uuid
  amount                 Decimal                 @db.Decimal(12, 2)
  method                 PaymentMethod
  reference              String?
  receivedAt             DateTime                @map("received_at") @db.Timestamptz(6)
  notes                  String?
  /// Set on a replacement payment: the (already reversed) payment it corrects.
  correctsPaymentId      String?                 @map("corrects_payment_id") @db.Uuid
  /// Receipt snapshot, written by a database trigger under the invoice lock and never updated. NULL on payments
  /// recorded before the snapshot existed; they are shown as "derived", never back-filled.
  creditTotalAtPayment   Decimal?                @map("credit_total_at_payment") @db.Decimal(12, 2)
  balanceAfterPayment    Decimal?                @map("balance_after_payment") @db.Decimal(12, 2)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resident        Resident                @relation(fields: [residentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  invoice         Invoice                 @relation(fields: [invoiceId, organizationId, residentId], references: [id, organizationId, residentId], onDelete: Restrict, onUpdate: Restrict)
  idempotencyKeys PaymentIdempotencyKey[]
  corrects        Payment?                @relation("PaymentCorrection", fields: [correctsPaymentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  replacements    Payment[]               @relation("PaymentCorrection")
  reversals       PaymentReversal[]
  @@unique([id, organizationId])
  @@unique([id, invoiceId, organizationId])
  @@unique([correctsPaymentId])
  @@index([invoiceId])
  @@index([organizationId, receivedAt])
  @@index([residentId, organizationId])
  @@map("payments")
}
/// Append-only: a payment is never edited; reversing it records one row here.
model PaymentReversal {
  correctionFinanceLinks CorrectionFinanceLink[]
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  paymentId              String                  @map("payment_id") @db.Uuid
  invoiceId              String                  @map("invoice_id") @db.Uuid
  reason                 String
  reversedBy             String                  @map("reversed_by") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment      Payment      @relation(fields: [paymentId, invoiceId, organizationId], references: [id, invoiceId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  actor        User         @relation(fields: [reversedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([paymentId])
  @@unique([id, invoiceId, organizationId])
  @@index([invoiceId])
  @@index([organizationId, createdAt])
  @@map("payment_reversals")
}
/// Append-only credit against an issued invoice. Credits are stored as negative amounts.
model InvoiceAdjustment {
  correctionFinanceLinks CorrectionFinanceLink[]
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  invoiceId              String                  @map("invoice_id") @db.Uuid
  residentId             String                  @map("resident_id") @db.Uuid
  amount                 Decimal                 @db.Decimal(12, 2)
  reason                 String
  createdBy              String                  @map("created_by") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId, organizationId, residentId], references: [id, organizationId, residentId], onDelete: Restrict, onUpdate: Restrict)
  actor        User         @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([id, invoiceId, organizationId])
  @@index([invoiceId])
  @@index([organizationId, createdAt])
  @@map("invoice_adjustments")
}
/// Append-only record that an invoice was voided. The invoice then sits in CANCELLED for good; payments, reversals
/// and credits are never touched. Legacy CANCELLED invoices have no row here and none is invented for them.
model InvoiceVoid {
  correctionFinanceLinks CorrectionFinanceLink[]
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  invoiceId              String                  @map("invoice_id") @db.Uuid
  residentId             String                  @map("resident_id") @db.Uuid
  /// Filled in by the database from the locked invoice; any value the caller sends is overwritten.
  previousStatus         InvoiceStatus           @map("previous_status")
  amountAtVoid           Decimal                 @map("amount_at_void") @db.Decimal(12, 2)
  reason                 String
  voidedBy               String                  @map("voided_by") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId, organizationId, residentId], references: [id, organizationId, residentId], onDelete: Restrict, onUpdate: Restrict)
  actor        User         @relation(fields: [voidedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([invoiceId])
  @@unique([id, invoiceId, organizationId])
  @@index([organizationId, createdAt])
  @@map("invoice_voids")
}
/// Append-only record of a client-supplied Idempotency-Key and the payment it produced.
model PaymentIdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  requestHash    String   @map("request_hash")
  paymentId      String   @map("payment_id") @db.Uuid
  response       Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment      Payment      @relation(fields: [paymentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  @@unique([organizationId, key])
  @@unique([paymentId])
  @@map("payment_idempotency_keys")
}
/// Persistent sign-in throttling. Keys are SHA-256 hashes, so no e-mail address or IP address is stored.
model LoginThrottle {
  scope           String
  keyHash         String    @map("key_hash")
  failures        Int       @default(0)
  windowStartedAt DateTime  @default(now()) @map("window_started_at") @db.Timestamptz(6)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@id([scope, keyHash])
  @@index([lockedUntil])
  @@map("login_throttles")
}
// ---------------------------------------------------------------------------------------------------------------
// P4-2 corrections. Constraints Prisma cannot express (partial unique indexes, CHECKs, immutability triggers) live in
// migration 20261108120000_p4_2_corrections and are the authority; this model mirrors the columns and relations.
// ---------------------------------------------------------------------------------------------------------------
enum CorrectionTargetType {
  RESIDENT
  BOOKING
  ADMISSION
  CHECK_IN
  CHECK_OUT
}
enum CorrectionFieldKey {
  firstName
  lastName
  startDate
  endDate
  monthlyPrice
  admissionDate
  checkInAt
  checkOutAt
  reason
}
enum CorrectionStatus {
  PENDING
  APPLIED
  REJECTED
  WITHDRAWN
  STALE
}
enum CorrectionRelationKind {
  REVERSAL
  SUPERSEDES
}
enum CorrectionCommandAction {
  SUBMIT
  APPROVE
  REJECT
  WITHDRAW
  RESOLVE
}
enum CorrectionFinanceLinkKind {
  BILLING_GAP
  INVOICE_REVIEW
  RESOLUTION
}
enum CorrectionFinanceOutcome {
  REVIEW_REQUIRED
  RELEASED
  NO_SUPPORTED_REMEDY
  OPERATION_RECORDED
}
/// One proposed change to one allowlisted field of one record. The payload is immutable once stored; only the single
/// PENDING -> terminal transition fields may be set (database trigger).
model CorrectionProposal {
  assignmentReplacements StayAssignmentReplacement[]
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  targetType         CorrectionTargetType    @map("target_type")
  fieldKey           CorrectionFieldKey      @map("field_key")
  status             CorrectionStatus        @default(PENDING)
  residentTargetId   String?                 @map("resident_target_id") @db.Uuid
  bookingTargetId    String?                 @map("booking_target_id") @db.Uuid
  admissionTargetId  String?                 @map("admission_target_id") @db.Uuid
  checkInTargetId    String?                 @map("check_in_target_id") @db.Uuid
  checkOutTargetId   String?                 @map("check_out_target_id") @db.Uuid
  originalValue      Json                    @map("original_value") @db.JsonB
  proposedValue      Json                    @map("proposed_value") @db.JsonB
  appliedValue       Json?                   @map("applied_value") @db.JsonB
  expectedSnapshot   Json                    @map("expected_snapshot") @db.JsonB
  reason             String
  evidenceReference  String?                 @map("evidence_reference")
  effectiveAt        DateTime                @map("effective_at") @db.Timestamptz(6)
  recordedAt         DateTime                @default(now()) @map("recorded_at") @db.Timestamptz(6)
  requestedBy        String                  @map("requested_by") @db.Uuid
  requestedRole      MembershipRole          @map("requested_role")
  decidedBy          String?                 @map("decided_by") @db.Uuid
  decidedAt          DateTime?               @map("decided_at") @db.Timestamptz(6)
  appliedAt          DateTime?               @map("applied_at") @db.Timestamptz(6)
  decisionReason     String?                 @map("decision_reason")
  exceptionRationale String?                 @map("exception_rationale")
  staleCause         String?                 @map("stale_cause")
  financialImpact    Boolean                 @map("financial_impact")
  correlationId      String                  @map("correlation_id") @db.Uuid
  relatedProposalId  String?                 @map("related_proposal_id") @db.Uuid
  relationKind       CorrectionRelationKind? @map("relation_kind")
  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resident     Resident?                  @relation("CorrectionResidentTarget", fields: [residentTargetId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  booking      Booking?                   @relation("CorrectionBookingTarget", fields: [bookingTargetId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  admission    Admission?                 @relation("CorrectionAdmissionTarget", fields: [admissionTargetId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  checkIn      CheckIn?                   @relation("CorrectionCheckInTarget", fields: [checkInTargetId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  checkOut     CheckOut?                  @relation("CorrectionCheckOutTarget", fields: [checkOutTargetId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  requester    User                       @relation("CorrectionRequester", fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decider      User?                      @relation("CorrectionDecider", fields: [decidedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  related      CorrectionProposal?        @relation("CorrectionRelated", fields: [relatedProposalId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  relatedFrom  CorrectionProposal[]       @relation("CorrectionRelated")
  receipts     CorrectionCommandReceipt[]
  financeLinks CorrectionFinanceLink[]
  @@unique([id, organizationId])
  @@unique([organizationId, requestedBy, correlationId])
  @@index([organizationId, status, recordedAt, id])
  @@map("correction_proposals")
}
/// Append-only record that a correction command committed. Created in the same transaction as its effect, so a receipt
/// exists if and only if the command committed. Holds codes and ids only, never protected values.
model CorrectionCommandReceipt {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  actorId        String                  @map("actor_id") @db.Uuid
  idempotencyKey String                  @map("idempotency_key") @db.Uuid
  requestCheck   String                  @map("request_check")
  proposalId     String                  @map("proposal_id") @db.Uuid
  action         CorrectionCommandAction
  outcomeCode    String                  @map("outcome_code")
  recordedAt     DateTime                @default(now()) @map("recorded_at") @db.Timestamptz(6)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor        User               @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  proposal     CorrectionProposal @relation(fields: [proposalId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  @@unique([organizationId, actorId, idempotencyKey])
  @@index([proposalId])
  @@map("correction_command_receipts")
}
/// Append-only Finance consequence of a correction: a billing gap awaiting OWNER review, an issued invoice needing review,
/// or a resolution of either. The scheduler and manual generation skip every booking-month with an unresolved gap.
model CorrectionFinanceLink {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  proposalId     String                    @map("proposal_id") @db.Uuid
  kind           CorrectionFinanceLinkKind
  outcome        CorrectionFinanceOutcome
  residentId     String                    @map("resident_id") @db.Uuid
  bookingId      String?                   @map("booking_id") @db.Uuid
  periodStart    DateTime?                 @map("period_start") @db.Date
  invoiceId      String?                   @map("invoice_id") @db.Uuid
  adjustmentId   String?                   @map("adjustment_id") @db.Uuid
  reversalId     String?                   @map("reversal_id") @db.Uuid
  voidId         String?                   @map("void_id") @db.Uuid
  paymentId      String?                   @map("payment_id") @db.Uuid
  resolvesLinkId String?                   @map("resolves_link_id") @db.Uuid
  resolvedBy     String?                   @map("resolved_by") @db.Uuid
  reason         String?
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  proposal     CorrectionProposal      @relation(fields: [proposalId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  resident     Resident                @relation(fields: [residentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  booking      Booking?                @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  invoice      Invoice?                @relation(fields: [invoiceId, organizationId, residentId], references: [id, organizationId, residentId], onDelete: Restrict, onUpdate: Restrict)
  adjustment   InvoiceAdjustment?      @relation(fields: [adjustmentId, invoiceId, organizationId], references: [id, invoiceId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  reversal     PaymentReversal?        @relation(fields: [reversalId, invoiceId, organizationId], references: [id, invoiceId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  void         InvoiceVoid?            @relation(fields: [voidId, invoiceId, organizationId], references: [id, invoiceId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  payment      Payment?                @relation(fields: [paymentId, invoiceId, organizationId], references: [id, invoiceId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  resolves     CorrectionFinanceLink?  @relation("CorrectionLinkResolution", fields: [resolvesLinkId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  resolutions  CorrectionFinanceLink[] @relation("CorrectionLinkResolution")
  resolver     User?                   @relation(fields: [resolvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([id, organizationId])
  @@index([organizationId, kind, bookingId, periodStart])
  @@index([proposalId])
  @@map("correction_finance_links")
}

// ================================================================================================
// P4-3 Room/Bed Transfers
// ================================================================================================

enum StayAssignmentKind {
  ORIGINAL
  TRANSFER
}

enum StayAssignmentStatus {
  ACTIVE
  COMPLETED
}

model StayAssignment {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  bookingId          String                  @map("booking_id") @db.Uuid
  residentId         String                  @map("resident_id") @db.Uuid
  bedId              String                  @map("bed_id") @db.Uuid
  kind               StayAssignmentKind      @default(ORIGINAL)
  status             StayAssignmentStatus    @default(ACTIVE)
  startAt            DateTime                @map("start_at") @db.Timestamptz(6)
  endAt              DateTime?               @map("end_at") @db.Timestamptz(6)
  transferId         String?                 @map("transfer_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  booking      Booking      @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  resident     Resident     @relation(fields: [residentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  bed          Bed          @relation(fields: [bedId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  transfer     Transfer?    @relation(fields: [transferId, organizationId], references: [id, organizationId], onDelete: SetNull, onUpdate: Restrict)

  @@unique([id, organizationId])
  @@index([organizationId, bookingId, startAt])
  @@index([organizationId, bedId, startAt, endAt])
  @@map("stay_assignments")
}

enum TransferType {
  ROOM_TRANSFER
  BED_TRANSFER
}

model Transfer {
  financeReviews TransferFinanceReview[]
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  residentId          String          @map("resident_id") @db.Uuid
  bookingId           String          @map("booking_id") @db.Uuid
  type                TransferType
  sourceBedId         String          @map("source_bed_id") @db.Uuid
  sourceRoomId        String          @map("source_room_id") @db.Uuid
  sourcePropertyId    String          @map("source_property_id") @db.Uuid
  destinationBedId    String          @map("destination_bed_id") @db.Uuid
  destinationRoomId   String          @map("destination_room_id") @db.Uuid
  destinationPropertyId String        @map("destination_property_id") @db.Uuid
  reason              String
  effectiveAt         DateTime        @map("effective_at") @db.Timestamptz(6)
  actorUserId         String          @map("actor_user_id") @db.Uuid
  actorRole           MembershipRole  @map("actor_role")
  idempotencyKey      String          @map("idempotency_key") @db.Uuid
  recordedAt          DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resident     Resident     @relation(fields: [residentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  booking      Booking      @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  sourceBed    Bed          @relation("TransferSourceBed", fields: [sourceBedId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  destBed      Bed          @relation("TransferDestBed", fields: [destinationBedId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  actor        User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignments  StayAssignment[]

  @@unique([id, organizationId])
  commandReceipt TransferCommandReceipt?
  @@unique([id, organizationId, actorUserId, idempotencyKey], map: "transfers_receipt_identity_key")
  @@unique([organizationId, actorUserId, idempotencyKey])
  @@index([organizationId, residentId, recordedAt])
  @@index([organizationId, bookingId, recordedAt])
  @@map("transfers")
  @@unique([id, organizationId, bookingId, residentId], map: "transfers_finance_identity_key")
}

/// Transfer-only immutable response receipt. requestCheck is an HMAC of the canonical request.
/// Written with the event/effects; replay must reauthorize and compare requestCheck before returning responseBody.
model TransferCommandReceipt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.Uuid
  transferId String @unique @map("transfer_id") @db.Uuid
  requestCheck String @map("request_check")
  responseBody Json @map("response_body") @db.JsonB
  responseVersion Int @default(1) @map("response_version")
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  transfer Transfer @relation(fields: [transferId, organizationId, actorId, idempotencyKey], references: [id, organizationId, actorUserId, idempotencyKey], onDelete: Restrict, onUpdate: Restrict, map: "transfer_command_receipts_event_fkey")
  @@unique([organizationId, actorId, idempotencyKey], map: "transfer_command_receipts_key")
  @@unique([transferId, organizationId, actorId, idempotencyKey], map: "transfer_command_receipts_identity_key")
  @@map("transfer_command_receipts")
}


/// Immutable boundary replacement; original StayAssignment records remain intact.
model StayAssignmentReplacement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  residentId String @map("resident_id") @db.Uuid
  proposalId String @unique @map("proposal_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  version Int
  fieldKey CorrectionFieldKey @map("field_key")
  beforeSegments Json @map("before_segments") @db.JsonB
  segments Json @db.JsonB
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  booking Booking @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  resident Resident @relation(fields: [residentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  proposal CorrectionProposal @relation(fields: [proposalId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([organizationId, bookingId, version])
  @@index([organizationId, bookingId])
  @@map("stay_assignment_replacements")
}

/// Read-only SQL projection, never a second mutable assignment store.
model EffectiveStayAssignment {
  id String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  residentId String @map("resident_id") @db.Uuid
  bedId String @map("bed_id") @db.Uuid
  kind StayAssignmentKind
  status StayAssignmentStatus
  startAt DateTime @map("start_at") @db.Timestamptz(6)
  endAt DateTime? @map("end_at") @db.Timestamptz(6)
  transferId String? @map("transfer_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  replacementId String? @map("replacement_id") @db.Uuid
  booking Booking @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
  bed Bed @relation(fields: [bedId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction)
  @@map("effective_stay_assignments")
}

model TransferFinanceReview {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  transferId String @map("transfer_id") @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  residentId String @map("resident_id") @db.Uuid
  requestedByUserId String @map("requested_by_user_id") @db.Uuid
  periodStart DateTime @map("period_start") @db.Date
  reason String
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transfer Transfer @relation(fields: [transferId, organizationId, bookingId, residentId], references: [id, organizationId, bookingId, residentId], onDelete: Restrict, onUpdate: Restrict)
  booking Booking @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  resident Resident @relation(fields: [residentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  requester User @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolution TransferFinanceResolution?
  @@unique([id, organizationId])
  @@unique([organizationId, transferId, periodStart])
  @@index([organizationId, bookingId, periodStart])
  @@map("transfer_finance_reviews")
}

model TransferFinanceResolution {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  reviewId String @unique @map("review_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  outcome String
  reason String
  idempotencyKey String @map("idempotency_key") @db.Uuid
  requestCheck String @map("request_check")
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  review TransferFinanceReview @relation(fields: [reviewId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([organizationId, actorUserId, idempotencyKey])
  @@unique([reviewId, organizationId])
  @@map("transfer_finance_resolutions")
}
