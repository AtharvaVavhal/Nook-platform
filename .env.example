# Local development only. Do not put a production secret here.
APP_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://nook:<password>@localhost:5433/nook_dev?schema=public
# Used only by docker-compose.yml to create the local database container (set a real value locally).
POSTGRES_PASSWORD=<password>

# Production wiring (documented in docs/ops/WEB_API_TOPOLOGY.md; set in the hosting platforms, never here):
#   API (Railway):  APP_ENV=production  WEB_ORIGIN=https://trynook.in  TRUST_PROXY_HOPS=1  LOG_LEVEL=info (optional)
#   Web (Vercel):   VITE_API_BASE=https://api.trynook.in/api/v1
# Logging and monitoring: docs/ops/OBSERVABILITY.md
#   Optional, API only: SENTRY_DSN (a secret; Railway variable, never committed), SENTRY_ENVIRONMENT
