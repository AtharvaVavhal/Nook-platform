# Local development only. Do not put a production secret here.
APP_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://nook:<password>@localhost:5433/nook_dev?schema=public
# Used only by docker-compose.yml to create the local database container (set a real value locally).
POSTGRES_PASSWORD=<password>

# Production wiring (documented in docs/ops/WEB_API_TOPOLOGY.md; set in the hosting platforms, never here):
#   API (Railway):  APP_ENV=production  WEB_ORIGIN=https://app.trynook.in  TRUST_PROXY_HOPS=1  LOG_LEVEL=info (optional)
#   Web (Vercel):   VITE_API_BASE=https://api.trynook.in/api/v1
# Logging and monitoring: docs/ops/OBSERVABILITY.md
#   Optional, API only: SENTRY_DSN (a secret; Railway variable, never committed), SENTRY_ENVIRONMENT

# Production API variables (Railway service variables only; full per-service list and rules: docs/production/RAILWAY_DEPLOYMENT_RUNBOOK.md):
#   APP_ENV, WEB_ORIGIN, TRUST_PROXY_HOPS (mandatory in production), LOG_LEVEL,
#   DATABASE_URL  runtime role only; production requires sslmode=verify-full, or sslmode=verify-ca with uselibpqcompat=true and
#                 a readable sslrootcert PEM file, otherwise the API refuses to start,
#   DB_CA_PEM     PEM of the database's ROOT CA certificate (public; with Railway's PostgreSQL template the self-signed
#                 `root-ca`, not the server/leaf certificate), written to the sslrootcert path by scripts/ops/start-api.sh;
#                 the migration job additionally needs DB_CERT_SHA256, the SHA-256 fingerprint of the LEAF (server) certificate,
#                 and DATABASE_URL must use the database's private DNS name, never an IP address,
#   CORRECTION_RECEIPT_SECRET  at least 32 random characters (a secret; the corrections endpoints answer 503 without it).
#   Leave unset: CORRECTIONS_FINANCIAL_APPLY_ENABLED, BILLING_SCHEDULER_ENABLED, SENTRY_DSN.

# Resident portal sign-in (Phase 1, backend only). OFF unless RESIDENT_WEB_ORIGIN is set. Set in the hosting platform, never here
# (docs/resident-portal/PHASE_1_RESIDENT_AUTH.md). No real SMS provider exists yet, so production must keep RESIDENT_SMS_PROVIDER=disabled.
#   RESIDENT_WEB_ORIGIN     exact origin of the resident portal, a different origin from WEB_ORIGIN (local example: http://localhost:5174)
#   RESIDENT_OTP_SECRET     at least 32 random characters (a secret); required whenever RESIDENT_WEB_ORIGIN is set
#   RESIDENT_SMS_PROVIDER   disabled (default) or mock (tests and non-production previews; the API refuses to start with mock in production)
